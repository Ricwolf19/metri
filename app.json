{
  "expo": {
    "name": "Metri",
    "slug": "metri",
    "version": "1.20.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "metri",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.ricwolf19.metri"
    },
    "android": {
      "package": "com.ricwolf19.metri",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0c0c0c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_SLEEP"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c0c0c",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#bef82b",
          "sounds": [
            "./assets/sounds/notify.wav",
            "./assets/sounds/rest_alarm.wav",
            "./assets/sounds/session_done.wav",
            "./assets/sounds/discard.wav"
          ]
        }
      ],
      [
        "react-native-notify-kit",
        {
          "android": {
            "icons": [
              {
                "name": "ic_notification",
                "path": "./assets/images/notification-icon.png",
                "type": "small"
              }
            ],
            "foregroundService": {
              "types": [
                "mediaPlayback"
              ]
            }
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Metri uses your photos to save progress pictures.",
          "cameraPermission": "Metri uses the camera for progress photos and to scan a shared program's code."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Metri uses the camera for progress photos and to scan a shared program's code.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "organization": "metri-ku",
          "project": "metri-mobile"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Metri",
              "label": "Metri",
              "description": "Daily calories, training streak and quick links.",
              "minWidth": "250dp",
              "minHeight": "120dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-status-bar",
      "expo-audio",
      "react-native-health-connect",
      [
        "expo-calendar",
        {
          "calendarPermission": "Metri adds your training days to a calendar on this phone.",
          "remindersPermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Metri uses Face ID to unlock your progress photos and settings."
        }
      ],
      "expo-quick-actions",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/7107cc0a-ed7d-4693-8138-96bf21f5b1bc"
    },
    "extra": {
      "eas": {
        "projectId": "7107cc0a-ed7d-4693-8138-96bf21f5b1bc"
      }
    },
    "owner": "ricwolf19"
  }
}
